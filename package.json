{
  "name": "appwrite-appexpress-mongoose-crud",
  "version": "1.0.0",
  "description": "TypeScript User CRUD REST API built with AppExpress, Mongoose, and Zod for Appwrite Functions & Node.js",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "tsx test/api.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "appwrite",
    "appexpress",
    "mongoose",
    "mongodb",
    "zod",
    "crud",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@itznotabug/appexpress": "^1.8.0",
    "dotenv": "^16.4.7",
    "mongoose": "^8.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
